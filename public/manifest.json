{
  "manifest_version": 3,
  "name": "Canvas Compass (CU Boulder)",
  "version": "1.0.0",
  "description": "Scans favorited Canvas courses and compiles every graded item and key date into one ranked, editable list.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Canvas Compass",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.canvas.colorado.edu/*",
        "https://canvas.colorado.edu/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "*://*.canvas.colorado.edu/*",
        "https://canvas.colorado.edu/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://*.canvas.colorado.edu/*",
    "https://generativelanguage.googleapis.com/*"
  ]
}
